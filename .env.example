# Fact Agent Configuration
# Copy to .env and fill in your values

# LLM API (required)
LLM_API_URL=http://localhost:3001/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=auto
LLM_TIMEOUT=60

# Memory
MEMORY_DB_PATH=memory.db
LONG_TERM_MEMORY_DB_PATH=long_term_memory.db
CONVERSATION_LIMIT=20
MEMORY_RETRIEVAL_LIMIT=8
MAX_FACT_LENGTH=500

# JANCTION Cloud Rendering (optional)
JANCTION_API_BASE=https://render.janction.jp
JANCTION_API_KEY_PATH=~/.config/fact-agent/janction_api_key.txt
JANCTION_TIMEOUT=30

# Gemini API (optional)
GEMINI_API_KEY=
GEMINI_API_KEY_PATH=gemini_api_key.txt

# Logging
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
LOG_FILE=logs/fact-agent.log

# Agent Behavior
ENABLE_SEMANTIC_RETRIEVAL=true
ENABLE_MEMORY_EXTRACTION=true
ENABLE_VECTOR_RETRIEVAL=true